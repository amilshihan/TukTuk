# Copy to .env.local and fill in. For APK builds, add the same values as EAS
# environment variables (preview and production).

# Supabase (required): Project Settings -> API Keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps (optional): map, place search and traffic-aware routes.
# Enable "Maps SDK for Android", "Places API (New)" and "Routes API" for this key.
# Without it the app uses free OpenStreetMap services.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
